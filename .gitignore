# Published evidence is metadata, not a downloaded dataset. Keep this exception
# narrow so checkpoints, images, and probability caches remain ignored here too.
!evidence/nnunet/datasets/
evidence/nnunet/datasets/**
!evidence/nnunet/datasets/*/
!evidence/nnunet/datasets/*/summary.json
!evidence/nnunet/datasets/*/case_paired_deltas.csv
!evidence/nnunet/datasets/*/AUDIT.json

