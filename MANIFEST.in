include LICENSE NOTICE.md LICENSES/*.txt
recursive-include configs *.yaml *.json *.md
recursive-include registry *.yaml *.json *.md
recursive-include docs *.md
recursive-include evidence *.md *.json *.csv
recursive-include environments *.txt *.md
recursive-include tests *.py
recursive-include scripts *.py *.sh *.md
recursive-include results *.md
global-exclude __pycache__ *.py[cod]
